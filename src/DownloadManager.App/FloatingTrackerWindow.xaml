<Window x:Class="DownloadManager.App.FloatingTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nahr Tracker"
        Icon="pack://application:,,,/Assets/nahr.ico"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseDoubleClick="OnMouseDoubleClick">

    <Grid Margin="14">
        <!-- ============================ Compact Pill Mode ============================ -->
        <!-- Shadow is isolated on a sibling Border behind the content so WPF never rasterizes
             the foreground logo, border, or text through a low-DPI Effect bitmap cache. -->
        <Grid x:Name="ExpandedCard" Width="276" Cursor="SizeAll">
            <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="14" Opacity="0.24" Color="#000000"/>
                </Border.Effect>
            </Border>

            <Border CornerRadius="16" Padding="12,10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nahr Icon (rendered directly at native HiDPI resolution) -->
                    <Image Grid.Column="0" Source="pack://application:,,,/Assets/logo.png" Width="36" Height="36"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <!-- Live Progress & Speed -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FloatingTitleText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding FloatingPercentText}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"/>
                        </Grid>

                        <ProgressBar Style="{StaticResource NahrProgressBar}" Height="5" Margin="0,5,0,4"
                                     Value="{Binding FloatingPercent, Mode=OneWay}"/>

                        <TextBlock Text="{Binding TotalSpeedText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <!-- Quick Open & Collapse to Mini Icon -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                Content="&#xE8A7;" Command="{Binding OpenActiveProgressCommand}"
                                ToolTip="{Binding [act_progress_win], Source={StaticResource Loc}}"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                Content="&#xE921;" Click="OnCollapseToMini" ToolTip="Mini Icon"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ Mini Floating Icon Badge Mode ============================ -->
        <!-- Shadow sits behind the crisp vector ring, HiDPI logo, and percentage pill so everything
             renders razor-sharp on 100%-200% Windows scaling with zero Effect blur. -->
        <Grid x:Name="MiniBadge" Width="64" Height="64" Visibility="Collapsed"
              Cursor="Hand" ToolTip="{Binding FloatingTitleText}">
            <Border CornerRadius="32" Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="12" Opacity="0.28" Color="#000000"/>
                </Border.Effect>
            </Border>

            <Border CornerRadius="32"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                <Grid>
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="36" Height="36"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Padding="7,1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <TextBlock Text="{Binding FloatingPercentText}" FontSize="10.5" FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
