<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Primary Surfaces (Fluent Windows 11 Deep Midnight) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#0B0F19"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#111827"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161F30"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1E293B"/>

    <!-- Hero / Subtle Tinted Card -->
    <LinearGradientBrush x:Key="HeroCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#172554" Offset="0"/>
        <GradientStop Color="#161F30" Offset="1"/>
    </LinearGradientBrush>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSoft" Color="#243046"/>
    <SolidColorBrush x:Key="BorderMedium" Color="#334155"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#64748B"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1E293B"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="0.55"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#451A03"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#450A0A"/>

    <!-- Category Icon Palettes -->
    <SolidColorBrush x:Key="CatVideoBg" Color="#2E1065"/>
    <SolidColorBrush x:Key="CatVideoFg" Color="#C084FC"/>
    <SolidColorBrush x:Key="CatMusicBg" Color="#500724"/>
    <SolidColorBrush x:Key="CatMusicFg" Color="#F472B6"/>
    <SolidColorBrush x:Key="CatArchiveBg" Color="#451A03"/>
    <SolidColorBrush x:Key="CatArchiveFg" Color="#FBBF24"/>
    <SolidColorBrush x:Key="CatProgramBg" Color="#064E3B"/>
    <SolidColorBrush x:Key="CatProgramFg" Color="#34D399"/>
    <SolidColorBrush x:Key="CatImageBg" Color="#0C4A6E"/>
    <SolidColorBrush x:Key="CatImageFg" Color="#38BDF8"/>
    <SolidColorBrush x:Key="CatDocBg" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="CatDocFg" Color="#60A5FA"/>

    <!-- Interaction & Toggle -->
    <SolidColorBrush x:Key="HoverBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#293548"/>
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF"/>

    <!-- Progress -->
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#243046"/>

    <!-- Overlay -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC0B0F19"/>

    <!-- Chrome / Title Bar -->
    <SolidColorBrush x:Key="ChromeBackground" Color="#111827"/>
    <SolidColorBrush x:Key="ChromeHover" Color="#1E293B"/>
    <SolidColorBrush x:Key="ChromeCloseHover" Color="#EF4444"/>
    <SolidColorBrush x:Key="ChromeCloseText" Color="#FFFFFF"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#475569"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="Transparent"/>

    <!-- Badge -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#94A3B8"/>

    <!-- Card Shadow -->
    <Color x:Key="CardShadowColor">#32000000</Color>

    <!-- Sidebar accent indicator -->
    <SolidColorBrush x:Key="SidebarAccentBar" Color="#3B82F6"/>
</ResourceDictionary>
