<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Primary Surfaces (Fluent Windows 11 Cool Slate) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F6FB"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>

    <!-- Hero / Subtle Tinted Card -->
    <LinearGradientBrush x:Key="HeroCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EFF6FF" Offset="0"/>
        <GradientStop Color="#F8FAFC" Offset="1"/>
    </LinearGradientBrush>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSoft" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderMedium" Color="#CBD5E1"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#94A3B8"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EFF6FF"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5E9" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="0.6"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2"/>

    <!-- Category Icon Palettes -->
    <SolidColorBrush x:Key="CatVideoBg" Color="#F3E8FF"/>
    <SolidColorBrush x:Key="CatVideoFg" Color="#7C3AED"/>
    <SolidColorBrush x:Key="CatMusicBg" Color="#FCE7F3"/>
    <SolidColorBrush x:Key="CatMusicFg" Color="#DB2777"/>
    <SolidColorBrush x:Key="CatArchiveBg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="CatArchiveFg" Color="#D97706"/>
    <SolidColorBrush x:Key="CatProgramBg" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="CatProgramFg" Color="#059669"/>
    <SolidColorBrush x:Key="CatImageBg" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="CatImageFg" Color="#0284C7"/>
    <SolidColorBrush x:Key="CatDocBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="CatDocFg" Color="#2563EB"/>

    <!-- Interaction & Toggle -->
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF"/>

    <!-- Progress -->
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E2E8F0"/>

    <!-- Overlay -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#750F172A"/>

    <!-- Chrome / Title Bar -->
    <SolidColorBrush x:Key="ChromeBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChromeHover" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ChromeCloseHover" Color="#EF4444"/>
    <SolidColorBrush x:Key="ChromeCloseText" Color="#FFFFFF"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="Transparent"/>

    <!-- Badge -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#64748B"/>

    <!-- Card Shadow -->
    <Color x:Key="CardShadowColor">#140F172A</Color>

    <!-- Sidebar accent indicator -->
    <SolidColorBrush x:Key="SidebarAccentBar" Color="#2563EB"/>
</ResourceDictionary>
