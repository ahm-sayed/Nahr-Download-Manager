<Window x:Class="DownloadManager.App.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/nahr.ico"
        Width="590" MinWidth="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        FlowDirection="{Binding IsRtl, Converter={StaticResource RtlToFlow}}"
        ResizeMode="CanMinimize">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid>
            <!-- ============================ Stage 1: Pre-Download ("Download File Info") ============================ -->
            <StackPanel Margin="22,18,22,20"
                        Visibility="{Binding IsPreDownload, Converter={StaticResource BoolToVis}}">

                <!-- Hero Summary Card -->
                <Border Background="{DynamicResource HeroCardBrush}" BorderBrush="{DynamicResource BorderSoft}"
                        BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{DynamicResource SelectedBrush}" CornerRadius="7" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CategoryText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoft}"
                                        BorderThickness="1" CornerRadius="7" Padding="8,2">
                                    <TextBlock Text="{Binding SizeText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Url}" Style="{StaticResource SecondaryText}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Video vs Audio Mode Switcher -->
                <Grid Margin="0,0,0,12"
                      Visibility="{Binding IsMediaClip, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="{Binding [dl_mode_label], Source={StaticResource Loc}}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <RadioButton IsChecked="{Binding IsVideoMode, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE714;" FontSize="13" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding [dl_mode_video], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton IsChecked="{Binding IsAudioMode, Mode=TwoWay}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xEC4F;" FontSize="13" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding [dl_mode_audio], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>

                <!-- Quality / Format Selector -->
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding HasQualities, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="{Binding [yt_quality], Source={StaticResource Loc}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActionStatusText}" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding HasActionStatus, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <ComboBox Style="{StaticResource NahrComboBox}"
                              ItemsSource="{Binding Qualities}"
                              SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                              DisplayMemberPath="Label"/>
                </StackPanel>

                <!-- Playlist Video Picker (only visible when downloading a YouTube Playlist) -->
                <Border Margin="0,0,0,12" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                        CornerRadius="10" ClipToBounds="True"
                        Visibility="{Binding HasPlaylistEntries, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Header: Select All + Selected Count Badge -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                                Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource RowSelectCheckBox}"
                                          IsChecked="{Binding IsAllPlaylistSelected, Mode=TwoWay}"
                                          Content="{Binding [pl_select_all], Source={StaticResource Loc}}"
                                          FontSize="12" FontWeight="SemiBold"/>
                                <Border Grid.Column="1" Background="{DynamicResource SelectedBrush}"
                                        CornerRadius="7" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlaylistSelectionSummaryText}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Scrollable Video Checklist -->
                        <ScrollViewer MaxHeight="205" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PlaylistEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderSoft}"
                                                BorderThickness="0,0,0,1" Padding="10,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource RowSelectCheckBox}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding IndexText}"
                                                           FontSize="11" Style="{StaticResource SecondaryText}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                                           FontSize="11" Style="{StaticResource SecondaryText}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Editable File Name -->
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"
                           Text="{Binding [dl_file_name], Source={StaticResource Loc}}"/>
                <TextBox Style="{StaticResource NahrTextBox}" Margin="0,0,0,12"
                         Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Save Folder -->
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"
                           Text="{Binding [add_folder], Source={StaticResource Loc}}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource NahrTextBox}"
                             Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Margin="8,0,0,0"
                            Command="{Binding BrowseCommand}"
                            Content="{Binding [add_browse], Source={StaticResource Loc}}"/>
                </Grid>

                <!-- Error Banner -->
                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="{Binding PreErrorMessage}"
                           Visibility="{Binding HasPreError, Converter={StaticResource BoolToVis}}"/>

                <!-- Action Buttons: Cancel | Download Later | Start Download -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SubtleButton}"
                            Command="{Binding CloseWindowCommand}"
                            Content="{Binding [btn_cancel], Source={StaticResource Loc}}"/>
                    <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                            Command="{Binding DownloadLaterCommand}"
                            Content="{Binding [dl_later_btn], Source={StaticResource Loc}}"/>
                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Padding="20,9"
                            Command="{Binding StartDownloadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [dl_start_btn], Source={StaticResource Loc}}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ============================ Stage 2: IDM-Style Multi-Tab Download Progress Window ============================ -->
            <StackPanel Margin="16,12,16,16"
                        Visibility="{Binding IsProgressMode, Converter={StaticResource BoolToVis}}">

                <!-- 3-Tab Header Strip: Download status | Speed Limiter | Options on completion -->
                <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                    <RadioButton Style="{StaticResource ProgressTabButton}" GroupName="dlTabs"
                                 IsChecked="{Binding IsStatusTab, Mode=TwoWay}"
                                 Content="{Binding [dl_tab_status], Source={StaticResource Loc}}"/>
                    <RadioButton Style="{StaticResource ProgressTabButton}" GroupName="dlTabs"
                                 IsChecked="{Binding IsSpeedLimiterTab, Mode=TwoWay}"
                                 Content="{Binding [dl_tab_limiter], Source={StaticResource Loc}}"/>
                    <RadioButton Style="{StaticResource ProgressTabButton}" GroupName="dlTabs"
                                 IsChecked="{Binding IsCompletionTab, Mode=TwoWay}"
                                 Content="{Binding [dl_tab_completion], Source={StaticResource Loc}}"/>
                </StackPanel>

                <!-- ======================= TAB 1: Download Status ======================= -->
                <StackPanel Visibility="{Binding IsStatusTab, Converter={StaticResource BoolToVis}}">

                    <!-- Structured IDM Telemetry Box -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderMedium}"
                            BorderThickness="1" CornerRadius="0,8,8,8" Padding="14,11"
                            DataContext="{Binding Item}">
                        <StackPanel>
                            <!-- Full URL Line -->
                            <TextBlock Text="{Binding Url}" FontSize="12" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>

                            <!-- Key-Value Telemetry Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="21"/>
                                    <RowDefinition Height="21"/>
                                    <RowDefinition Height="21"/>
                                    <RowDefinition Height="21"/>
                                    <RowDefinition Height="21"/>
                                    <RowDefinition Height="21"/>
                                </Grid.RowDefinitions>

                                <!-- Status -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding [dl_status_row], Source={StaticResource Loc}}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LiveStatusDetailText}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- File Size -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding [dl_filesize_row], Source={StaticResource Loc}}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>

                                <!-- Downloaded + Exact Percentage -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding [dl_downloaded_label], Source={StaticResource Loc}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailedDownloadedText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <!-- Transfer Rate -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding [dl_speed_label], Source={StaticResource Loc}}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailedSpeedText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>

                                <!-- Time Left -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding [dl_eta_label], Source={StaticResource Loc}}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailedEtaText}" FontSize="12" VerticalAlignment="Center"/>

                                <!-- Resume Capability -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding [dl_resume_row], Source={StaticResource Loc}}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RangesText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupportsRanges}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{Binding ErrorMessage}"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Overall Progress Bar -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderMedium}"
                            BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,10,0,10">
                        <ProgressBar Style="{StaticResource NahrProgressBar}" Height="14"
                                     Value="{Binding Item.ProgressPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding Item.IsIndeterminate, Mode=OneWay}"/>
                    </Border>

                    <!-- Action Row (Active / Paused): [<< Hide details]   ......   [Pause / Resume] [Cancel] -->
                    <Grid Visibility="{Binding IsActiveOrPaused, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SubtleButton}" MinWidth="130" Padding="14,6"
                                BorderThickness="1"
                                Command="{Binding ToggleDetailsCommand}"
                                Content="{Binding DetailsToggleText}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" DataContext="{Binding Item}">
                            <Button Style="{StaticResource AccentButton}" MinWidth="98" Padding="16,6" Margin="0,0,8,0"
                                    Command="{Binding StartCommand}"
                                    Content="{Binding PrimaryActionText}"
                                    Visibility="{Binding ShowStart, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SubtleButton}" MinWidth="98" Padding="16,6" Margin="0,0,8,0"
                                    Command="{Binding PauseCommand}"
                                    Content="{Binding [act_pause], Source={StaticResource Loc}}"
                                    Visibility="{Binding ShowPause, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SubtleButton}" MinWidth="98" Padding="16,6"
                                    Command="{Binding CancelCommand}"
                                    Content="{Binding [act_cancel], Source={StaticResource Loc}}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Action Row (Completed): [✓ Completed]   ......   [Close] [Open Folder] [Open] -->
                    <Grid Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="15"
                                       Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [dl_completed_msg], Source={StaticResource Loc}}"
                                       Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SubtleButton}" Padding="14,6" Margin="0,0,8,0"
                                    Command="{Binding CloseWindowCommand}"
                                    Content="{Binding [btn_close], Source={StaticResource Loc}}"/>
                            <Button Style="{StaticResource SubtleButton}" Padding="14,6" Margin="0,0,8,0"
                                    Command="{Binding Item.OpenFolderCommand}"
                                    Content="{Binding [act_open_folder], Source={StaticResource Loc}}"/>
                            <Button Style="{StaticResource AccentButton}" Padding="18,6"
                                    Command="{Binding Item.OpenCommand}"
                                    Content="{Binding [act_open], Source={StaticResource Loc}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Collapsible IDM Connection Positions Map + Per-Connection Table -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding ShowConnectionDetails, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="{Binding [dl_conn_positions], Source={StaticResource Loc}}"
                                   FontSize="11.5" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center" Margin="0,0,0,5"/>

                        <!-- Visual Multi-Connection Start Positions & Progress Map Bar -->
                        <Border Height="16" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" CornerRadius="2"
                                ClipToBounds="True" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding Item.Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Style="{StaticResource SegmentMapBar}"
                                                         Value="{Binding Percent, Mode=OneWay}"/>
                                            <!-- IDM-style red connection start-position marker -->
                                            <Border Width="2" HorizontalAlignment="Left"
                                                    Background="{DynamicResource DangerBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Connections Table (N. | Downloaded | Info) -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderMedium}"
                                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <StackPanel>
                                <!-- Table Header -->
                                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSoft}"
                                        BorderThickness="0,0,0,1" Padding="10,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [dl_col_num], Source={StaticResource Loc}}"
                                                   FontSize="11.5" FontWeight="SemiBold" Style="{StaticResource SecondaryText}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding [dl_col_downloaded], Source={StaticResource Loc}}"
                                                   FontSize="11.5" FontWeight="SemiBold" Style="{StaticResource SecondaryText}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding [dl_col_info], Source={StaticResource Loc}}"
                                                   FontSize="11.5" FontWeight="SemiBold" Style="{StaticResource SecondaryText}"/>
                                    </Grid>
                                </Border>

                                <!-- Table Rows -->
                                <ScrollViewer Height="136" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Item.Segments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                                                        Padding="10,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="125"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="68"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11.5"
                                                                   Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding BytesOnlyText}" FontSize="11.5"
                                                                   FontWeight="Medium" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding InfoText}" FontSize="11.5"
                                                                   Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Grid.Column="3" Style="{StaticResource NahrProgressBar}" Height="4"
                                                                     Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ======================= TAB 2: Speed Limiter ======================= -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderMedium}"
                        BorderThickness="1" CornerRadius="0,8,8,8" Padding="18,16"
                        Visibility="{Binding IsSpeedLimiterTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource RowSelectCheckBox}"
                                  IsChecked="{Binding UseSpeedLimiter, Mode=TwoWay}"
                                  Content="{Binding [dl_limiter_enable], Source={StaticResource Loc}}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="25,5,0,16"
                                   TextWrapping="Wrap"
                                   Text="{Binding [dl_limiter_hint], Source={StaticResource Loc}}"/>

                        <TextBlock FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"
                                   Text="{Binding [dl_limiter_rate], Source={StaticResource Loc}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBox Style="{StaticResource NahrTextBox}" Width="150"
                                     Text="{Binding SpeedLimitKBpsText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource AccentButton}" Margin="10,0,0,0" Padding="16,8"
                                    Command="{Binding ApplySpeedLimitCommand}"
                                    Content="{Binding [dl_limiter_apply], Source={StaticResource Loc}}"/>
                        </StackPanel>

                        <!-- Quick Speed Presets -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SubtleButton}" Padding="10,5" Margin="0,0,6,0"
                                    Command="{Binding Preset256Command}" Content="256 KB/s"/>
                            <Button Style="{StaticResource SubtleButton}" Padding="10,5" Margin="0,0,6,0"
                                    Command="{Binding Preset512Command}" Content="512 KB/s"/>
                            <Button Style="{StaticResource SubtleButton}" Padding="10,5" Margin="0,0,6,0"
                                    Command="{Binding Preset1024Command}" Content="1 MB/s"/>
                            <Button Style="{StaticResource SubtleButton}" Padding="10,5" Margin="0,0,6,0"
                                    Command="{Binding Preset2048Command}" Content="2 MB/s"/>
                            <Button Style="{StaticResource SubtleButton}" Padding="10,5"
                                    Command="{Binding Preset5120Command}" Content="5 MB/s"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======================= TAB 3: Options on Completion ======================= -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderMedium}"
                        BorderThickness="1" CornerRadius="0,8,8,8" Padding="18,16"
                        Visibility="{Binding IsCompletionTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource RowSelectCheckBox}" Margin="0,0,0,12"
                                  IsChecked="{Binding CloseOnComplete, Mode=TwoWay}"
                                  Content="{Binding [dl_close_on_complete], Source={StaticResource Loc}}"/>
                        <CheckBox Style="{StaticResource RowSelectCheckBox}" Margin="0,0,0,12"
                                  IsChecked="{Binding OpenFileOnComplete, Mode=TwoWay}"
                                  Content="{Binding [dl_open_on_complete], Source={StaticResource Loc}}"/>
                        <CheckBox Style="{StaticResource RowSelectCheckBox}" Margin="0,0,0,16"
                                  IsChecked="{Binding OpenFolderOnComplete, Mode=TwoWay}"
                                  Content="{Binding [dl_open_folder_on_complete], Source={StaticResource Loc}}"/>

                        <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="0,0,0,4"
                                   Text="{Binding [det_path], Source={StaticResource Loc}}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Item.FilePath}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Item.FilePath}"/>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Padding="12,6" Margin="10,0,0,0"
                                    Command="{Binding Item.OpenFolderCommand}"
                                    Content="{Binding [act_open_folder], Source={StaticResource Loc}}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
